{
    "name": "mgamadeus/ddd-agents",
    "description": "The agentic loop for mgamadeus/ddd: conversations, messages, compaction, the task plan, skills and MCP metadata, purposes and criteria, widgets and signal sources, delegation, the supervisor and run claims",
    "minimum-stability": "stable",
    "license": "MIT",
    "version": "0.1.0-alpha.13",
    "authors": [
        {
            "name": "Marius-Eugen Gerdan",
            "email": "marius@gerdan.net"
        }
    ],
    "require": {
        "mgamadeus/ddd": "^3.27.0",
        "mgamadeus/ddd-argus": "^1.3.2",
        "mgamadeus/ddd-ai": "^3.2.1",
        "mgamadeus/ddd-common-money": "^1.1.1",
        "erusev/parsedown": "^1.7"
    },
    "autoload": {
        "psr-4": {
            "DDD\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "DDD\\Tests\\Agents\\": "tests/"
        },
        "exclude-from-classmap": [
            "tests/Fixtures/Application/src/"
        ]
    },
    "extra": {
        "ddd-module": "DDD\\Modules\\Agents\\AgentsModule"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.3"
    }
}
