{
  "name": "@mgamadeus/ddd-agents",
  "version": "0.1.0-alpha.16",
  "description": "The web frontend of the ddd-agents module: the agent chat, the widget renderer and the composed-view kit.",
  "keywords": [
    "ddd",
    "mgamadeus",
    "agents",
    "react"
  ],
  "homepage": "https://github.com/ddd-framework/ddd-agents/tree/main/web#readme",
  "bugs": {
    "url": "https://github.com/ddd-framework/ddd-agents/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ddd-framework/ddd-agents.git",
    "directory": "web"
  },
  "license": "MIT",
  "author": "Marius-Eugen Gerdan <marius@gerdan.net>",
  "type": "module",
  "sideEffects": [
    "**/*.css",
    "./dist/index.js",
    "./dist/renderer.js",
    "./dist/kit.js",
    "./dist/widgets.js",
    "./dist/chat.js",
    "./dist/preview.js",
    "./dist/image-render.js",
    "./dist/chunks/*.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/types/entries/index.d.ts",
      "import": "./dist/index.js"
    },
    "./renderer": {
      "types": "./dist/types/entries/renderer.d.ts",
      "import": "./dist/renderer.js"
    },
    "./kit": {
      "types": "./dist/types/entries/kit.d.ts",
      "import": "./dist/kit.js"
    },
    "./widgets": {
      "types": "./dist/types/entries/widgets.d.ts",
      "import": "./dist/widgets.js"
    },
    "./contract": {
      "types": "./dist/types/entries/contract.d.ts",
      "import": "./dist/contract.js"
    },
    "./client": {
      "types": "./dist/types/entries/client.d.ts",
      "import": "./dist/client.js"
    },
    "./client/testing": {
      "types": "./dist/types/entries/client-testing.d.ts",
      "import": "./dist/client-testing.js"
    },
    "./chat": {
      "types": "./dist/types/entries/chat.d.ts",
      "import": "./dist/chat.js"
    },
    "./preview": {
      "types": "./dist/types/entries/preview.d.ts",
      "import": "./dist/preview.js"
    },
    "./image-render": {
      "types": "./dist/types/entries/image-render.d.ts",
      "import": "./dist/image-render.js"
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && vite build && tsc -p tsconfig.build.json && node scripts/check-package.mjs .",
    "check-package": "node scripts/check-package.mjs .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.build.json --noEmit --declaration false --emitDeclarationOnly false"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "@types/google.maps": "^3.55.0",
    "apexcharts": "^3.35.0",
    "axios": "^0.28.0",
    "dompurify": "^3.4.0",
    "highlight.js": "^11.12.0",
    "katex": "^0.19.0",
    "mermaid": "^12.2.0",
    "react": "^19.2.0",
    "react-apexcharts": "^1.4.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "axios": {
      "optional": true
    }
  },
  "devDependencies": {
    "@reduxjs/toolkit": "1.9.7",
    "@testing-library/dom": "10.4.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/google.maps": "^3.55.0",
    "@types/node": "22.10.0",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "apexcharts": "^3.35.0",
    "axios": "^0.28.0",
    "dompurify": "^3.4.0",
    "highlight.js": "^11.12.0",
    "jsdom": "29.1.1",
    "katex": "^0.19.0",
    "mdast-util-directive": "3.1.0",
    "mermaid": "^12.2.0",
    "react": "^19.2.0",
    "react-apexcharts": "^1.4.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-redux": "9.2.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "sass": "1.79.6",
    "typescript": "7.0.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0",
    "vite": "7.3.1",
    "vitest": "4.1.9"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@12.16.1"
}
