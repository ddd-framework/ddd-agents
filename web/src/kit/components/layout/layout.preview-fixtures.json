                {
                  "type": "Pressable",
                  "onClick": {
                    "set": "channel"
                  },
                  "value": "Paid",
                  "isSelected": {
                    "$computed": "isPaid"
                  },
                  "label": "Paid auswählen",
                  "children": [
                    {
                      "type": "KpiTile",
                      "label": "Paid",
                      "value": 2620,
                      "unit": "Besucher",
                      "detail": "32,0 % Anteil"
                    }
                  ]
                },
                {
                  "type": "Pressable",
                  "onClick": {
                    "set": "channel"
                  },
                  "value": "Direct",
