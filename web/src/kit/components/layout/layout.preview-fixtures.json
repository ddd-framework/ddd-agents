            {
              "name": "Paid",
              "visitors": 2620,
              "share": "32,0 % Anteil"
            },
            {
              "name": "Direct",
              "visitors": 1390,
              "share": "16,9 % Anteil"
            }
          ]
        },
        "computed": {
          "isOrganic": "channel == \"Organic\"",
          "isPaid": "channel == \"Paid\"",
          "isDirect": "channel == \"Direct\""
