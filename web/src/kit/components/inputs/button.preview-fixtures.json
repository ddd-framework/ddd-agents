                    "$computed": "mrrMonth12"
                  },
                  "format": "currency",
                  "currency": "EUR",
                  "decimals": 0
                },
                {
                  "type": "KpiTile",
                  "label": "Net growth / month",
                  "value": {
                    "$computed": "netGrowth"
                  },
                  "format": "percent",
                  "decimals": 0,
                  "tone": "success",
                  "signed": true
                }
              ]
            },
            {
              "type": "Chart",
              "kind": "line",
              "data": {
                "$computed": "series"
              },
              "x": "month",
              "series": [
                {
                  "field": "mrr",
                  "label": "MRR"
                }
              ],
              "valueFormat": "currency",
              "currency": "EUR"
            },
            {
              "type": "Slider",
              "label": "Starting customers",
              "min": 100,
              "max": 2000,
              "step": 50,
              "value": {
                "$state": "startCustomers"
              },
              "onChange": {
                "set": "startCustomers"
              }
            },
            {
              "type": "Divider"
            },
            {
              "type": "Grid",
              "columns": 2,
              "gap": "small",
              "children": [
                {
                  "type": "KpiTile",
                  "label": "Growth rate",
                  "value": {
                    "$computed": "growth"
                  },
                  "format": "percent",
                  "decimals": 0,
                  "signed": true
                },
                {
                  "type": "KpiTile",
                  "label": "Churn rate",
                  "value": {
                    "$computed": "churn"
                  },
                  "format": "percent",
                  "decimals": 0
                }
              ]
            },
            {
              "type": "Button",
              "label": "Copy scenario data as JSON",
              "icon": "copy",
              "fullWidth": true,
              "onClick": {
                "action": "copyScenario"
              }
            }
          ]
        }
      },
      "expectedState": "data",
      "width": 528,
      "interactions": [
        {
          "name": "bull scenario",
          "click": {
            "text": "Bull"
          }
        },
        {
          "name": "more starting customers",
          "click": {
            "selector": ".MuiSlider-thumb"
          },
          "press": "ArrowRight"
        },
        {
          "name": "copy scenario",
          "click": {
            "text": "Copy scenario data as JSON"
          }
        }
      ]
    },
    {
      "name": "button-replay",
      "description": "The same buttons on a replayed message: visible, inert (mode replay shows it; here the tree is the plain button row).",
      "payload": {
        "state": {
          "visitors": 35000
        },
        "actions": {
          "reset": {
            "type": "resetState"
          },
          "copyResult": {
            "type": "copy",
            "value": {
              "$state": "visitors"
            }
          }
        },
        "view": {
          "type": "Stack",
          "direction": "row",
          "gap": "small",
          "children": [
            {
              "type": "Button",
              "label": "Copy JSON",
              "icon": "copy",
              "onClick": {
                "action": "copyResult"
              }
            },
            {
              "type": "Button",
              "label": "Reset",
              "icon": "reset",
              "variant": "secondary",
              "onClick": {
                "action": "reset"
              }
            }
          ]
        }
      },
      "expectedState": "data",
      "width": 528
    }
  ]
