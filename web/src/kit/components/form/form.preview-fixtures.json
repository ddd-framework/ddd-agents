          ],
          "children": [
            {
              "type": "Input",
              "label": "Recipient",
              "inputType": "email",
              "placeholder": "name@example.com",
              "value": {
                "$state": "recipient"
              },
              "onChange": {
                "set": "recipient"
              }
            },
            {
              "type": "Input",
              "label": "Subject",
              "value": {
                "$state": "subject"
              },
              "onChange": {
                "set": "subject"
              }
            },
            {
              "type": "Textarea",
              "label": "Your question",
              "rows": 7,
              "value": {
                "$state": "message"
              },
              "onChange": {
                "set": "message"
              }
            }
          ]
        }
      },
      "expectedState": "data",
      "width": 528
    }
  ]
