# The reference application's environment: every name it reads. Copy to .env (git-ignored) and fill the empty
# key-shaped values; .env.local (git-ignored) overrides .env, the process environment wins over both. Without a .env
# the bootstrap loads this file. No model provider is called: the model answers come from a recording.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=
DB_DEFAULT_CONNECTION_DRIVER=pdo_mysql
DB_DEFAULT_CONNECTION_HOST=127.0.0.1
DB_DEFAULT_CONNECTION_HOST_PORT=3307
DB_DEFAULT_CONNECTION_DB_NAME=ddd_agents_reference
DB_DEFAULT_CONNECTION_USER=
DB_DEFAULT_CONNECTION_PASSWORD=
DB_DEFAULT_CONNECTION_DB_SERVER_VERSION=mariadb-11.8.5
DB_DEFAULT_CONNECTION_DB_SERVER_CHARSET=utf8mb4
LAZYLOAD_DEFAULT_REPO_TYPE=DB
REFERENCE_DEMO_OWNER_ACCOUNT_ID=1
CACHE_APC_TTL=3600
OPENROUTER_KEY=
JWT_HASH_KEY=
JWT_HASH_METHOD=HS256
