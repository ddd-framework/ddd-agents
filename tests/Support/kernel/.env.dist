# The package test kernel's environment: every name it reads. Not loaded as is — the package run takes its values
# from tests/Support/PackageTestEnvironment.php (key-shaped values there are fake: test-not-a-secret). To use your own
# values, copy this file to tests/Support/kernel/.env.test (git-ignored) and fill it; the process environment wins
# over both. Key-shaped values stay empty here. The database tests need no file: DDD_AGENTS_TEST_DRIVER=pdo_mysql or
# pdo_pgsql selects the throwaway database of tests/Integration/docker-compose.yml.
APP_ENV=test
APP_DEBUG=0
APP_SECRET=
DB_DEFAULT_CONNECTION_DRIVER=pdo_mysql
DB_DEFAULT_CONNECTION_HOST=127.0.0.1
DB_DEFAULT_CONNECTION_HOST_PORT=3307
DB_DEFAULT_CONNECTION_DB_NAME=ddd_agents_test
DB_DEFAULT_CONNECTION_USER=
DB_DEFAULT_CONNECTION_PASSWORD=
DB_DEFAULT_CONNECTION_DB_SERVER_VERSION=mariadb-11.8.5
DB_DEFAULT_CONNECTION_DB_SERVER_CHARSET=utf8mb4
DB_DEFAULT_DOCTRINE_PROXY_GENERATION_MODE=AUTOGENERATE_EVAL
DB_DEFAULT_DIRECT_HOST=127.0.0.1
DB_DEFAULT_DIRECT_PORT=5434
DATABASE_TABLE_PREFIX=
LAZYLOAD_DEFAULT_REPO_TYPE=DB
